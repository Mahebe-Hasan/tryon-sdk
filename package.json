{
  "name": "tryon-sdk",
  "version": "0.0.3",
  "private": true,
  "description": "Browser-based, real-time virtual try-on for makeup and press-on nails.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/tryon.esm.js",
  "module": "./dist/tryon.esm.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/tryon.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "build": "npm run build:sdk && npm run build:demo",
    "build:sdk": "vite build --config vite.sdk.config.ts && tsc -p tsconfig.sdk.json",
    "build:demo": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "earcut": "^3.2.4"
  }
}
